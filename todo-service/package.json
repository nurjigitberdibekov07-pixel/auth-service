{
  "name": "todo-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --env-file=.env.test --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node --env-file=.env.test src/db/migrate.js && node --env-file=.env.test --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "test:coverage": "node --env-file=.env.test --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0"
  }
}
