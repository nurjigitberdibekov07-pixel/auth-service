# Скопируйте этот файл в .env и заполните значения. Описание: ../ENV.md
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_service

# ДОЛЖЕН БЫТЬ ТОТ ЖЕ, что JWT_ACCESS_SECRET в auth-service,
# иначе todo-service не сможет проверить подпись токена
JWT_ACCESS_SECRET=замените-на-тот-же-секрет-что-в-auth-service