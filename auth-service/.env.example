# Скопируйте этот файл в .env и заполните значения. Описание: ../ENV.md
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Подключение к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service

# Секреты подписи токенов: минимум 32 символа, access и refresh РАЗНЫЕ
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=замените-на-случайную-строку-от-32-символов
JWT_REFRESH_SECRET=замените-на-другую-случайную-строку-от-32-символов
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=*

# Пароль демо-пользователей для npm run db:seed
SEED_DEMO_PASSWORD=Password123